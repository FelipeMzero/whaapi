# ──────────────────────────────────────────────
# WhaAPI — variáveis de ambiente
# Copie para .env e ajuste os valores
# ──────────────────────────────────────────────

# Servidor
PORT=8080
HTTPS_PORT=8443
SERVER_URL=http://localhost:8080
# Para habilitar HTTPS, informe os caminhos do certificado e da chave:
SSL_CERT=
SSL_KEY=

# Autenticação global da API (header: apikey)
API_KEY=whaapi-change-me

# WhatsApp Business Cloud API (oficial Meta) — opcional
CLOUDAPI_TOKEN=
CLOUDAPI_VERIFY_TOKEN=whaapi-verify
CLOUDAPI_VERSION=v20.0

# RabbitMQ (AMQP)
RABBITMQ_ENABLED=false
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=whaapi.events

# Apache Kafka
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=whaapi
KAFKA_TOPIC=whaapi-events

# Amazon SQS
SQS_ENABLED=false
SQS_REGION=us-east-1
SQS_QUEUE_URL=
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=

# Amazon S3 / MinIO (armazenamento de mídia)
S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=whaapi
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# OpenAI (transcrição de áudio e chatbot)
OPENAI_API_KEY=

# Socket.io
WEBSOCKET_ENABLED=true

# Logs: trace | debug | info | warn | error
LOG_LEVEL=info
